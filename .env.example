# ===== 模型配置 =====
# 主模型：DeepSeek API（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 降级模型：本地 Ollama（离线可用，效果弱于 API）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ===== 搜索工具配置 =====
# bing（默认，国内直连免费，无需 key）或 tavily（质量更高，需 key）
SEARCH_PROVIDER=bing
TAVILY_API_KEY=tvly-xxxxxxxx

# ===== 运行预算 =====
MAX_PLAN_STEPS=6          # Planner 最多拆解步骤数
MAX_ITERATIONS=4          # Reflector 最多循环轮数
MAX_SEARCHES_PER_STEP=5   # 单步最多搜索次数
MAX_REPORT_LENGTH=3000    # 最终报告最大字数

# ===== 私有知识库（CourseRAG 集成，可选）=====
# 启用后 Executor 会额外挂载 course_retrieve 工具；服务不可达时自动降级 web_search
RAG_BASE_URL=http://127.0.0.1:8001
RAG_TIMEOUT=20
RAG_TOP_K=5
